function resolveCommand(name) {
    const canExecute = (candidate) => {
        try {
            (0, node_fs_3.accessSync)(candidate, process.platform === "win32" ? node_fs_3.constants.F_OK : node_fs_3.constants.X_OK);
            return true;
        }
        catch {
            return false;
        }
    };
    if ((0, node_path_3.isAbsolute)(name) || name.includes("/") || name.includes("\\")) {
        return canExecute(name) ? name : null;
    }
    const pathEntries = (process.env.PATH ?? "")
        .split(node_path_3.delimiter)
        .map((entry) => entry.replace(/^"|"$/gu, ""))
        .filter((entry) => entry.length > 0);
    const extensions = process.platform === "win32" && !(0, node_path_3.extname)(name)
        ? (process.env.PATHEXT ?? ".COM;.EXE;.BAT;.CMD")
            .split(";")
            .filter((extension) => extension.length > 0)
        : [""];
    for (const pathEntry of pathEntries) {
        for (const extension of extensions) {
            const candidate = (0, node_path_1.join)(pathEntry, `${name}${extension}`);
            if (canExecute(candidate)) {
                return candidate;
            }
        }
    }
    return null;
}
