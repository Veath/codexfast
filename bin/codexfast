function childEnvWithAutomaticUpdateSetting(env = process.env) {
    const codexHome = resolveCodexHome(env);
    if (!codexHome) {
        return env;
    }
    const hookPath = writeMainProcessAutomaticUpdateHook(codexHome);
    const nodeOptions = env.NODE_OPTIONS?.trim();
